# frozen_string_literal: true

# Fastlane for Android + iOS. Run from photobooth/:
#   bundle exec fastlane android generatebuild   # AAB + APK; AAB → Play Console internal; log both paths
#   bundle exec fastlane android firebase        # existing APK → Firebase App Tester (no version bump)
#   bundle exec fastlane ios generatebuild       # → App Store Connect (TestFlight)
#   bundle exec fastlane android build     # build AAB only
#   bundle exec fastlane ios build         # build IPA only

require_relative 'fastfile_helpers'
PhotoboothFastfile.load_photobooth_dotenv!

# Ensure UTF-8 locale for Ruby string handling and all subprocesses (flutter, pod).
ENV['LANG'] ||= 'en_US.UTF-8'
ENV['LC_ALL'] ||= 'en_US.UTF-8'

opt_out_usage

def in_photobooth_root(&block)
  Dir.chdir(PhotoboothFastfile.photobooth_root, &block)
end

# --- Android distribution config (edit these values) ---
# Auth: photobooth/.env FIREBASE_TOKEN (`firebase login:ci`) or credentials/firebase-service-account.json.
# The Google principal must be App Distribution Admin on Firebase project fotozenai-e615b.
# Must match android/app/google-services.json (fotozenai-e615b). App Tester uses this app.
FIREBASE_ANDROID_APP_ID = '1:957532952151:android:f8a8844f87ba55fd563512'
FIREBASE_ANDROID_GROUPS = 'testers'
FIREBASE_SERVICE_ACCOUNT_PATH = File.expand_path('credentials/firebase-service-account.json', __dir__)
PLAY_STORE_JSON_KEY_PATH = File.expand_path('credentials/play-store-service-account.json', __dir__)
PLAY_STORE_TRACK = 'internal'
ANDROID_PACKAGE_NAME = 'com.srisarani.fotozenai'

# --- iOS / App Store Connect config (edit these values) ---
IOS_BUNDLE_IDENTIFIER = 'com.srisarani.fotozenai'
IOS_TEAM_ID = 'WR859F2ZHY'
IOS_EXPORT_OPTIONS_PLIST = File.join(PhotoboothFastfile.photobooth_root, 'ios/ExportOptions.plist')
APP_STORE_CONNECT_KEY_ID = '3Y28UQD6SG'
APP_STORE_CONNECT_ISSUER_ID = 'cbbdda4e-337b-47d3-970b-297d14aee134'
APP_STORE_CONNECT_API_KEY_PATH = File.expand_path('credentials/AuthKey_3Y28UQD6SG.p8', __dir__)

PLAY_STORE_TRACKS = %w[internal alpha beta production].freeze

def log_build_version(build_label)
  info = PhotoboothFastfile.app_version
  UI.message("App version: #{info[:version_name]}")
  UI.message("Version code: #{info[:version_code]}")
  UI.message("Starting #{build_label}...")
end

def sync_build_version!(build_number: nil)
  cmd = 'dart run tool/sync_build_version.dart'
  cmd += " --build-number=#{build_number}" unless build_number.nil?
  in_photobooth_root { sh(cmd) }
end

# Store latest + 1 (never lower than local pubspec), then write that exact string to pubspec.yaml
# so the AAB/APK/IPA and pubspec stay in lockstep.
def sync_pubspec_from_store!(store_label, latest_store)
  local_build = PhotoboothFastfile.app_version[:version_code].to_i
  next_build = PhotoboothFastfile.next_store_build_number(
    latest_store: latest_store,
    local_build: local_build
  )
  version_name = PhotoboothFastfile.release_version_name
  UI.message("#{store_label} latest build: #{latest_store}")
  UI.message("Local pubspec build: #{local_build}")
  UI.message("Next #{store_label} version: #{version_name}+#{next_build}")
  if latest_store.to_i.zero?
    UI.important(
      "#{store_label} returned 0. Confirm #{version_name}+#{next_build} is higher " \
      'than the last uploaded store build.'
    )
  end
  sync_build_version!(build_number: next_build)
  info = PhotoboothFastfile.app_version
  UI.success(
    "Updated pubspec.yaml to #{info[:version_name]}+#{info[:version_code]} " \
    "(same version as this #{store_label} upload)"
  )
end

def play_store_version_codes_for_track(track)
  google_play_track_version_codes(
    package_name: ANDROID_PACKAGE_NAME,
    track: track,
    json_key: PLAY_STORE_JSON_KEY_PATH
  )
rescue StandardError => e
  abort_on_play_store_auth_error!(e)
  UI.important("Could not read version codes for Play track '#{track}': #{e.message}")
  []
end

def latest_play_store_version_code
  PLAY_STORE_TRACKS.flat_map { |track| play_store_version_codes_for_track(track) }.map(&:to_i).max.to_i
end

def sync_android_build_version!
  sync_pubspec_from_store!('Play Store', latest_play_store_version_code)
end

def sync_ios_build_version!
  latest = latest_testflight_build_number(
    api_key: load_app_store_connect_api_key,
    app_identifier: IOS_BUNDLE_IDENTIFIER,
    initial_build_number: 0
  ).to_i
  sync_pubspec_from_store!('TestFlight', latest)
end

def validate_android_play_store_config!
  assert_play_store_key!
end

def validate_android_firebase_config!
  assert_firebase_auth!
  assert_firebase_android_app_id!
end

def validate_ios_distribution_config!
  assert_app_store_connect_key_id!
  assert_app_store_connect_issuer_id!
  assert_app_store_connect_api_key!
  assert_ios_export_options!
end

def firebase_cli_token_value
  token = ENV['FIREBASE_TOKEN']
  return nil if PhotoboothFastfile.firebase_token_missing?(token)

  token
end

def firebase_service_credentials_path
  return FIREBASE_SERVICE_ACCOUNT_PATH if File.exist?(FIREBASE_SERVICE_ACCOUNT_PATH)

  nil
end

def assert_firebase_auth!
  return if firebase_service_credentials_path
  return unless PhotoboothFastfile.firebase_token_missing?(firebase_cli_token_value)

  UI.user_error!(
    'Firebase App Tester auth is missing. Put FIREBASE_TOKEN in photobooth/.env ' \
    '(from `firebase login:ci` on a Google account with App Distribution access ' \
    "to fotozenai-e615b) or save #{FIREBASE_SERVICE_ACCOUNT_PATH}."
  )
end

def assert_firebase_android_app_id!
  return unless FIREBASE_ANDROID_APP_ID.nil? || FIREBASE_ANDROID_APP_ID.empty?

  UI.user_error!('Set FIREBASE_ANDROID_APP_ID in fastlane/Fastfile.')
end

def play_store_auth_error?(message)
  msg = message.to_s.downcase
  msg.include?('invalid_grant') ||
    msg.include?('invalid jwt') ||
    msg.include?('authorization failed') ||
    msg.include?('unauthorized')
end

def abort_on_play_store_auth_error!(error)
  return unless play_store_auth_error?(error.message)

  UI.user_error!(
    "Play Store authentication failed: #{error.message.split("\n").first}. " \
    'Create a new JSON key for the service account in Google Cloud, replace ' \
    "#{PLAY_STORE_JSON_KEY_PATH}, and invite that client_email in Play Console " \
    '→ Users and permissions. Do not upload until Play auth works — otherwise ' \
    'the version code will not match the store.'
  )
end

def firebase_permission_error?(message)
  msg = message.to_s.downcase
  msg.include?('required permissions on the firebase project') ||
    msg.include?('app distribution not onboarded') ||
    msg.include?('could not find your app') ||
    msg.include?('could not find your firebase project')
end

def firebase_tester_group_missing?(message)
  msg = message.to_s.downcase
  msg.include?('could not find your tester group') ||
    (msg.include?('groups exist') && msg.include?('group alias'))
end

def abort_on_firebase_permission_error!(error)
  return unless firebase_permission_error?(error.message)

  UI.user_error!(
    "Firebase App Tester upload failed: #{error.message.split("\n").first}. " \
    'Add the FIREBASE_TOKEN Google account (or firebase-service-account.json ' \
    'client_email) as Owner, Editor, or Firebase App Distribution Admin on ' \
    'https://console.firebase.google.com/project/fotozenai-e615b/settings/iam ' \
    'then App Distribution → Get started, and create group alias testers. ' \
    'Do not re-run android generatebuild (Play already has this version). ' \
    'From photobooth/: bundle exec fastlane android firebase'
  )
end

def assert_play_store_key!
  unless File.exist?(PLAY_STORE_JSON_KEY_PATH)
    UI.user_error!(
      "Play Store key not found at #{PLAY_STORE_JSON_KEY_PATH}. " \
      'Place the service account JSON there or update PLAY_STORE_JSON_KEY_PATH in Fastfile.'
    )
  end

  validate_play_store_json_key(json_key: PLAY_STORE_JSON_KEY_PATH)
rescue StandardError => e
  abort_on_play_store_auth_error!(e)
  raise
end

def assert_app_store_connect_key_id!
  return unless PhotoboothFastfile.app_store_connect_key_id_missing?(APP_STORE_CONNECT_KEY_ID)

  UI.user_error!(
    'Set APP_STORE_CONNECT_KEY_ID in fastlane/Fastfile ' \
    '(App Store Connect → Users and Access → Integrations → App Store Connect API).'
  )
end

def assert_app_store_connect_issuer_id!
  return unless PhotoboothFastfile.app_store_connect_issuer_id_missing?(APP_STORE_CONNECT_ISSUER_ID)

  UI.user_error!('Set APP_STORE_CONNECT_ISSUER_ID in fastlane/Fastfile.')
end

def assert_app_store_connect_api_key!
  return if File.exist?(APP_STORE_CONNECT_API_KEY_PATH)

  UI.user_error!(
    "App Store Connect API key not found at #{APP_STORE_CONNECT_API_KEY_PATH}. " \
    'Download the .p8 key from App Store Connect and save it there.'
  )
end

def assert_ios_export_options!
  return if File.exist?(IOS_EXPORT_OPTIONS_PLIST)

  UI.user_error!("Export options plist not found at #{IOS_EXPORT_OPTIONS_PLIST}.")
end

def assert_bugsnag_api_key!
  in_photobooth_root do
    sh('source scripts/load_env.sh && load_photobooth_env "$(pwd)" && test -n "${BUGSNAG_API_KEY:-}"')
  end
rescue StandardError
  UI.user_error!(
    'BUGSNAG_API_KEY is required for release builds. ' \
    'Add it to photobooth/.env (see .env.example) or set the BUGSNAG_API_KEY env var (CI).'
  )
end

def android_release_build_command
  PhotoboothFastfile.unbundled_flutter_command(
    './scripts/flutter_with_version.sh build appbundle --release'
  )
end

def android_release_apk_command
  PhotoboothFastfile.unbundled_flutter_command(
    './scripts/flutter_with_version.sh build apk --release'
  )
end

def ios_release_build_command
  PhotoboothFastfile.unbundled_flutter_command(
    './scripts/flutter_with_version.sh build ipa --release ' \
    "--export-options-plist=#{IOS_EXPORT_OPTIONS_PLIST}"
  )
end

def verify_android_artifact!(path, label)
  UI.user_error!("#{label} not found at #{path}") unless File.exist?(path)
  # Google Play / Android 15+ require 16 KB ELF alignment on 64-bit native libs.
  in_photobooth_root { sh("./scripts/verify_16kb_alignment.sh #{path}") }
end

def build_android_aab
  log_build_version('Android App Bundle (AAB)')
  assert_bugsnag_api_key!
  in_photobooth_root { sh(android_release_build_command) }
  verify_android_artifact!(PhotoboothFastfile.android_aab_path, 'AAB')
end

def build_android_apk
  log_build_version('Android APK')
  assert_bugsnag_api_key!
  in_photobooth_root { sh(android_release_apk_command) }
  apk = PhotoboothFastfile.android_apk_path
  UI.user_error!("APK not found at #{apk}") unless File.exist?(apk)
end

def log_android_artifact_paths
  aab = PhotoboothFastfile.android_aab_path
  apk = PhotoboothFastfile.android_apk_path
  UI.success("AAB: #{aab}")
  UI.success("APK: #{apk}")
end

def build_ios_ipa
  log_build_version('iOS IPA')
  assert_bugsnag_api_key!
  in_photobooth_root { sh(ios_release_build_command) }
  ipa = Dir.glob(PhotoboothFastfile.ios_ipa_glob).first
  UI.user_error!('IPA not found under build/ios/ipa/') unless ipa
  ipa
end

def firebase_distribution_params(groups:)
  params = {
    app: FIREBASE_ANDROID_APP_ID,
    android_artifact_type: 'APK',
    android_artifact_path: PhotoboothFastfile.android_apk_path,
    release_notes: PhotoboothFastfile.default_release_notes
  }
  creds = firebase_service_credentials_path
  if creds
    params[:service_credentials_file] = creds
  else
    params[:firebase_cli_token] = firebase_cli_token_value
  end
  params[:groups] = groups unless groups.to_s.empty?
  params
end

def distribute_android_apk_to_firebase
  apk = PhotoboothFastfile.android_apk_path
  UI.user_error!("APK not found at #{apk}. Build the release APK first.") unless File.exist?(apk)

  groups = FIREBASE_ANDROID_GROUPS
  begin
    firebase_app_distribution(firebase_distribution_params(groups: groups))
  rescue StandardError => e
    retry_firebase_without_group_or_reraise(e, groups)
  end
end

def retry_firebase_without_group_or_reraise(error, groups)
  if firebase_tester_group_missing?(error.message) && !groups.to_s.empty?
    UI.important("Tester group '#{groups}' was not found. Uploading without a group.")
    firebase_app_distribution(firebase_distribution_params(groups: nil))
    return
  end
  abort_on_firebase_permission_error!(error)
  raise error
end

def upload_android_aab_to_play_store
  upload_to_play_store(
    track: PLAY_STORE_TRACK,
    aab: PhotoboothFastfile.android_aab_path,
    package_name: ANDROID_PACKAGE_NAME,
    json_key: PLAY_STORE_JSON_KEY_PATH,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true
  )
end

def load_app_store_connect_api_key
  app_store_connect_api_key(
    key_id: APP_STORE_CONNECT_KEY_ID,
    issuer_id: APP_STORE_CONNECT_ISSUER_ID,
    key_filepath: APP_STORE_CONNECT_API_KEY_PATH,
    duration: 1200,
    in_house: false
  )
end

def upload_ios_ipa_to_app_store_connect(ipa_path)
  upload_to_testflight(
    api_key: load_app_store_connect_api_key,
    ipa: ipa_path,
    app_identifier: IOS_BUNDLE_IDENTIFIER,
    skip_waiting_for_build_processing: false,
    wait_processing_interval: 30,
    wait_processing_timeout_duration: 3600
  )
end

default_platform(:android)

platform :android do
  desc 'Sync version, build AAB and APK, upload AAB to Play Console internal, and log both paths'
  lane :generatebuild do
    validate_android_play_store_config!
    sync_android_build_version!
    build_android_aab
    build_android_apk
    upload_android_aab_to_play_store
    log_android_artifact_paths
  end

  desc 'Upload the existing release APK to Firebase App Tester (no Play upload, no version bump)'
  lane :firebase do
    validate_android_firebase_config!
    distribute_android_apk_to_firebase
  end

  desc 'Sync version and build release AAB only (no upload)'
  lane :build do
    validate_android_play_store_config!
    sync_android_build_version!
    build_android_aab
  end
end

platform :ios do
  desc 'Sync version, build release IPA, and upload to App Store Connect (TestFlight)'
  lane :generatebuild do
    validate_ios_distribution_config!
    sync_ios_build_version!
    ipa = build_ios_ipa
    upload_ios_ipa_to_app_store_connect(ipa)
  end

  desc 'Sync version and build release IPA only (no upload)'
  lane :build do
    validate_ios_distribution_config!
    sync_ios_build_version!
    build_ios_ipa
  end
end
