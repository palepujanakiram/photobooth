# Copy to `.env` in this directory (photobooth/) and fill in values.
# `.env` and `.env.local` are gitignored.
#
# BUGSNAG_API_KEY is injected at build time for release/profile mobile builds only
# (not debug). Used by scripts/flutter_with_version.sh and Fastlane.
#
# FIREBASE_TOKEN: `firebase login:ci` while signed into a Google account that is
# Owner, Editor, or Firebase App Distribution Admin on project fotozenai-e615b.
# Used by Fastlane android generatebuild / android firebase (App Tester).

BUGSNAG_API_KEY=
FIREBASE_TOKEN=
