<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary action (Retake), matching captureScreenButtonStyle(secondary: true) in
  photo_capture_view_handlers.dart: Colors.grey (#9E9E9E), same 14dp radius as the primary.
  Disabled shares the primary's Colors.grey.shade600 (#757575).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#757575" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7E7E7E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#9E9E9E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
