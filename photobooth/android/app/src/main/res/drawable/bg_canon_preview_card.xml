<?xml version="1.0" encoding="utf-8"?>
<!--
  The viewfinder card. Flutter insets the preview and draws a rounded hairline border around
  it rather than running the image full-bleed, so the native screen does the same.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/black" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
</shape>
