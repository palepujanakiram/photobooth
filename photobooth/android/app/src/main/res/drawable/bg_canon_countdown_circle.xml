<?xml version="1.0" encoding="utf-8"?>
<!--
  Countdown numeral backdrop, matching CaptureCountdownOverlay:
  a 150dp disc of Colors.grey at 38% alpha (#9E9E9E → #619E9E9E).

  Flutter draws a soft BoxShadow under it. Android shape drawables have no blur, so the
  TextView carries an `elevation` instead.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#619E9E9E" />
</shape>
