<?xml version="1.0" encoding="utf-8"?>
<!--
  API traffic uses HTTPS. DNP WCM Plus on the event LAN is discovered at runtime
  and speaks HTTP (/api/PrintImage), so cleartext is permitted for those hosts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
