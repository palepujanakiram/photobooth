<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the native DSLR capture screen only.

  These are fallbacks. Guest-facing copy is passed in from Dart on the launch request
  (CaptureSessionContract.Request) so AppStrings stays the single source of truth and the
  booth's wording is not duplicated across two stacks. What is left here is what shows if
  the caller sends nothing, plus the diagnostic states Dart has no opinion about.
-->
<resources>
    <string name="canon_capture_title">Camera</string>
    <!-- Booth layout: matches the Flutter capture bar exactly (photo_capture_view_scaffold). -->
    <string name="canon_capture_title_booth">POSE</string>
    <string name="canon_capture_subtitle">Step in front of the camera and strike your best look</string>
    <string name="canon_capture_shutter">Take shot</string>
    <string name="canon_capture_cancel">Cancel</string>

    <!-- Top-bar actions, mirroring the Flutter capture AppBar's icon row. -->
    <string name="canon_action_select_camera">Select camera</string>
    <string name="canon_action_rotate">Rotate preview</string>
    <string name="canon_action_reconnect">Reconnect camera</string>

    <string name="canon_status_connecting">Connecting to camera…</string>
    <string name="canon_status_reconnecting">Reconnecting to the camera…</string>
    <string name="canon_status_capturing">Hold still…</string>
    <string name="canon_status_processing">Saving photo…</string>
    <string name="canon_status_capture_failed">That shot did not land. Try again.</string>
    <string name="canon_status_ready_format">Ready — shot %1$d of %2$d</string>
    <string name="canon_status_pose_format">Get ready — shot %1$d of %2$d</string>
    <string name="canon_status_rearrange_format">Rearrange for shot %1$d of %2$d — %3$ds</string>
</resources>
