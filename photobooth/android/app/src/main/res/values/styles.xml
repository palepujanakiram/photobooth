<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Application as a whole. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Application as a whole. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    <!--
      Native DSLR capture screen. Black background and no animation so entering and leaving
      reads as a screen change within the booth flow rather than a switch to another app —
      the Activity sits on top of the Flutter one mid-session.
    -->
    <!--
      Not .Fullscreen: the Flutter capture screen keeps the status bar, drawing its content
      behind a transparent one (extendBodyBehindAppBar + SystemUiOverlayStyle.light). The
      native screen hid it entirely, so moving between the two made the clock and battery
      appear and disappear — the one thing CaptureScreenStyle.BOOTH exists to prevent.
      Transparent bars plus fitsSystemWindows on the chrome reproduces the Flutter layout.
    -->
    <style name="CanonCaptureTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

