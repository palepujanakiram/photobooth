<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Canon Selphy Direct Wi‑Fi: bind process to printer AP (no internet). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- FCM: show notifications / delivery on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Canon EDSDK sidecar runs as a foreground Service (Android 8+ requirement). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- connectedDevice foregroundServiceType requires this on Android 14+ (API 34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>

    <!-- Camera: required for capture and for camera list (availableCameras) -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Storage: for saving/reading photos (Android 12 and below). tools:replace overrides camera plugin's maxSdkVersion. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>

    <!-- Storage: for images on Android 13+ (replaces READ/WRITE_EXTERNAL_STORAGE for media) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.external" android:required="false"/>
    <!-- Override CameraX plugin merge: TV boxes often have no built-in camera. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required"/>
    <!-- RECORD_AUDIO from camera plugin; kiosk uses USB camera without a mic. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Allow install and run on Android TV (D-pad/remote; no touchscreen) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.faketouch" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>

    <application
        android:label="Fotozen AI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- USB/UVC camera attach support (for UVC plugin / kiosk rigs). -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
        <!--
          Native DSLR capture screen (direct PTP). Not exported: it is only ever started by
          MainActivity via CanonPtpMethodChannel, and it drives a USB device.

          configChanges mirrors MainActivity so a rotation does not recreate the Activity
          mid-session — that would drop the shots taken so far and restart live view. The
          app locks no orientation anywhere, so this screen inherits it too.

          finishOnTaskLaunch / excludeFromRecents keep POSE out of task restore. This is a
          second Activity in MainActivity's task, and onCreate() unconditionally calls
          startSession(), which auto-starts the countdown. So if the booth is left or killed
          while POSE is on top, relaunching from the launcher or Recents restored this screen
          and began counting down — the guest saw a live viewfinder and a timer before the
          Terms screen they never accepted. Finishing it on task launch sends the relaunch to
          MainActivity, which is the only correct entry point for the flow.
        -->
        <activity
            android:name=".canoncapture.CanonCaptureActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/CanonCaptureTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:hardwareAccelerated="true" />

        <!--
          Canon EDSDK sidecar: manages the native camera process.

          Declared even when CanonCameraStack.current is PTP — an undeclared service that is
          never started costs nothing, whereas a missing declaration turns flipping the stack
          constant into a runtime crash rather than a rebuild. MainActivity gates whether it
          actually starts.
        -->
        <service
            android:name=".canon.CanonSidecarService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller/Vulkan blanks Pose on Amlogic Mini PC / Android TV.
             flutter run uses no-enable-impeller; APKs need this meta-data. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>

